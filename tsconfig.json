{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vite/client", "vitest/importMeta"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    // Mirrors the Vite alias: the web app, the tests, the benchmark and the
    // CLI sources are all type-checked against `packages/core`'s TypeScript,
    // never against its emitted `dist`. `packages/*/tsconfig.build.json` is
    // what checks the packages the way Node will actually load them.
    "paths": {
      "@promptrim/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": ["src", "test", "bench", "packages/*/src", "vite.config.ts", "eslint.config.js"]
}
