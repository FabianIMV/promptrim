      "type": "quantity",
      "anchor": "400"
    },
    {
      "type": "prohibition",
      "anchor": "Do not use future tense"
    },
    {
      "type": "format",
      "anchor": "2 sentences"
    },
    {
      "type": "format",
      "anchor": "markdown"
    },
    {
      "type": "literal",
